{
  "openapi": "3.1.0",
  "info": {
    "title": "Corpi Core",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/demo/stream": {
      "get": {
        "summary": "Demo Stream",
        "description": "Transport proof for authenticated streaming: SSE-formatted chunks over plain HTTP.\n\nRead with fetch + Authorization header, never browser EventSource (which cannot\nsend the per-launch token). Later import-progress and answer-token streams reuse\nthis shape.",
        "operationId": "demo_stream_demo_stream_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/jobs": {
      "get": {
        "summary": "List Jobs",
        "operationId": "list_jobs_jobs_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/JobOverview"
                  },
                  "type": "array",
                  "title": "Response List Jobs Jobs Get"
                }
              }
            }
          }
        }
      }
    },
    "/jobs/{job_id}": {
      "get": {
        "summary": "Job Detail",
        "operationId": "job_detail_jobs__job_id__get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobDetailPayload"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JobAttemptPayload": {
        "properties": {
          "step_key": {
            "type": "string",
            "title": "Step Key"
          },
          "attempt_number": {
            "type": "integer",
            "title": "Attempt Number"
          },
          "started_at": {
            "type": "string",
            "title": "Started At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "failure_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failure Reason"
          }
        },
        "type": "object",
        "required": [
          "step_key",
          "attempt_number",
          "started_at",
          "finished_at",
          "failure_reason"
        ],
        "title": "JobAttemptPayload"
      },
      "JobDetailPayload": {
        "properties": {
          "job": {
            "$ref": "#/components/schemas/JobOverview"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/JobStepPayload"
            },
            "type": "array",
            "title": "Steps"
          },
          "attempts": {
            "items": {
              "$ref": "#/components/schemas/JobAttemptPayload"
            },
            "type": "array",
            "title": "Attempts"
          }
        },
        "type": "object",
        "required": [
          "job",
          "steps",
          "attempts"
        ],
        "title": "JobDetailPayload"
      },
      "JobOverview": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "current_step_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Step Key"
          },
          "attempt_count": {
            "type": "integer",
            "title": "Attempt Count"
          },
          "failure_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failure Reason"
          },
          "updated_at": {
            "type": "string",
            "title": "Updated At"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "status",
          "current_step_key",
          "attempt_count",
          "failure_reason",
          "updated_at",
          "kind"
        ],
        "title": "JobOverview"
      },
      "JobStepPayload": {
        "properties": {
          "step_key": {
            "type": "string",
            "title": "Step Key"
          },
          "committed_at": {
            "type": "string",
            "title": "Committed At"
          },
          "checkpoint_format_version": {
            "type": "integer",
            "title": "Checkpoint Format Version"
          },
          "checkpoint": {
            "$ref": "#/components/schemas/JsonValue"
          }
        },
        "type": "object",
        "required": [
          "step_key",
          "committed_at",
          "checkpoint_format_version",
          "checkpoint"
        ],
        "title": "JobStepPayload"
      },
      "JsonValue": {},
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
