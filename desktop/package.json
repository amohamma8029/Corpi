{
  "name": "corpi-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm copy:pdfjs && vite",
    "build": "pnpm generate:api && pnpm copy:pdfjs && tsc && vite build",
    "preview": "vite preview",
    "generate:api": "openapi-typescript ../core/openapi.json -o src/api/generated/schema.d.ts",
    "copy:pdfjs": "node scripts/copy-pdfjs-assets.mjs",
    "check:api": "node scripts/check-api.mjs",
    "test": "vitest run",
    "test:e2e": "node scripts/run-native-e2e.mjs",
    "test:e2e:embedded": "node scripts/run-native-e2e.mjs --embedded",
    "check:e2e": "tsc --project tsconfig.e2e.json",
    "check:webdriver-isolation": "node scripts/check-webdriver-isolation.mjs",
    "check:security": "node --max-old-space-size=128 --test --test-concurrency=1 scripts/security-patches.test.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "pdfjs-dist": "6.3.289",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "@testing-library/react": "^16.3.0",
    "@types/node": "26.6.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.0",
    "@wdio/cli": "^9.20.0",
    "@wdio/globals": "^9.20.0",
    "@wdio/local-runner": "^9.20.0",
    "@wdio/mocha-framework": "^9.20.0",
    "@wdio/spec-reporter": "^9.20.0",
    "@wdio/tauri-service": "1.4.0",
    "jsdom": "^27.0.0",
    "openapi-typescript": "^7.10.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.7",
    "vitest": "^5.1.0"
  }
}
